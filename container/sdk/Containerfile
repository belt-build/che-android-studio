# che-android-studio-sdk — the GUI-capable, user-EXTENSIBLE Android toolchain base.
#
# Carries the Android SDK (one or more API levels, NO emulator), a JDK for the SDK
# tools, the JCEF-enabled JetBrains Runtime the IDE flavors boot on (ASfP's
# Cuttlefish view needs JCEF), AND the GUI + streaming RUNTIME libraries the
# streamed desktop needs (X libs, mesa/DRI, fonts, openbox, dbus, and everything
# the relocated KasmVNC server dynamically links / execs — see the KasmVNC block).
#
# This image is the TOOLCHAIN layer in the container-contribution model:
#   1. It is the workspace's dev/tools container — the editor definition's
#      `controller.devfile.io/container-contribution` MERGES the IDE + streaming
#      config into it at runtime. The IDE + KasmVNC binaries themselves arrive on a
#      shared volume (staged by the *-editor injector), so they are NOT baked here;
#      only the non-relocatable RUNTIME LIBS they link against live here.
#   2. It is the contribution's placeholder image, so a workspace with no dev
#      container of its own still runs the desktop standalone on this image.
#   3. Users EXTEND it (`FROM …/sdk`) to add their own SDK levels + "other assorted
#      tools" — the toolchain is theirs to own, the editor just streams onto it.
#   4. It is usable directly, headless, for regular Android app CI builds (gradle).
#
# It is flavor-NEUTRAL: no IDE_FLAVOR / version env lives here (that is editor-only).
#
# Build: podman build -t che-android-studio-sdk:latest -f container/sdk/Containerfile container/

# Official Ubuntu base.
FROM docker.io/library/ubuntu:22.04
ARG DEBIAN_FRONTEND=noninteractive

# JDK for sdkmanager + headless gradle builds; unzip for cmdline-tools; curl +
# CAs for the downloads. sudo so the workspace user can install packages at
# runtime.
RUN apt-get update && apt-get install -y --no-install-recommends \
        openjdk-17-jdk-headless \
        ca-certificates curl unzip \
        sudo \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Passwordless sudo for the arbitrary restricted-SCC UID (it's in group 0).
# %sudo isn't enough (the UID has no group membership), so allow ALL — fine for
# a single-user dev container.
RUN echo 'ALL ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers

# --- GUI + streaming RUNTIME libraries --------------------------------------
# These CANNOT be shipped on the shared volume: they are resolved by ld.so /
# fontconfig / xkb path lookup or exec'd by bare name, so they must exist in
# whatever container the desktop runs in. Two groups:
#
#   (a) What ASfP/IntelliJ + openbox render against (GTK/X/mesa/fonts). NO Xvfb —
#       KasmVNC ships its own X server (Xkasmvnc).
#   (b) The RELOCATED KasmVNC server's runtime deps. KasmVNC has no portable
#       tarball, so the *-editor image extracts its .deb payload onto the volume;
#       but Xkasmvnc + the kasmvncserver Perl launcher still dynamically link /
#       `use` these. This set is the KasmVNC .deb's own `Depends:` (libs, the
#       xkb/xauth/font tooling, and the launcher's Perl modules). Keep it in sync
#       with KASMVNC_VERSION in container/editor/Containerfile.
RUN apt-get update && apt-get install -y --no-install-recommends \
        openbox \
        dbus-x11 \
        x11-xserver-utils x11-utils x11-xkb-utils \
        xkb-data xauth \
        libgl1 libgl1-mesa-dri libgbm1 \
        libxtst6 libxrender1 libxi6 libxss1 libxcomposite1 \
        libxrandr2 libxdamage1 libxfixes3 libxkbfile1 \
        libxcursor1 libxfont2 libxshmfence1 libpixman-1-0 \
        libgtk-3-0 libnss3 libcups2 libasound2 libpango-1.0-0 \
        libfreetype6 libpng16-16 libunwind8 libbsd0 \
        fonts-dejavu-core fonts-noto-cjk fonts-noto-color-emoji \
        desktop-file-utils procps \
        perl libswitch-perl libyaml-tiny-perl libhash-merge-simple-perl \
        liblist-moreutils-perl libtry-tiny-perl \
        libdatetime-perl libdatetime-timezone-perl \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# --- X11 socket dir ---------------------------------------------------------
# Xkasmvnc creates its socket under /tmp/.X11-unix. Under the restricted SCC the
# arbitrary UID can't mkdir it at runtime — pre-create it sticky/world-writable.
# (The entrypoint also does this, belt-and-suspenders, for BYO dev containers.)
RUN mkdir -p /tmp/.X11-unix && chmod 1777 /tmp/.X11-unix

# --- Arbitrary-UID passwd/group fix -----------------------------------------
# Under OpenShift's restricted SCC the container runs as an arbitrary UID in
# group 0 with no /etc/passwd entry → `groups: cannot find name for group ID
# 1000` in the terminal. Make the DBs group-writable so the entrypoint can
# append an entry at runtime as the (group-0) arbitrary UID.
RUN chmod g=u /etc/passwd /etc/group

# --- JCEF-enabled JetBrains Runtime -----------------------------------------
# The bundled ASfP JBR has NO JCEF; the Cuttlefish view (a JCEF webview) needs
# it. Pin the JBR-with-JCEF build the IDE expects and stage it where the
# entrypoint will point studio.jdk. Verified URL (302 → JetBrains CDN).
ARG JCEF_JBR_VERSION=21.0.9-linux-x64-b1163.94
ARG JCEF_JBR_URL=https://cache-redirector.jetbrains.com/intellij-jbr/jbr_jcef-${JCEF_JBR_VERSION}.tar.gz
ENV JCEF_JBR_DIR=/opt/che-android-studio/jbr-jcef
RUN set -eux; \
    mkdir -p "${JCEF_JBR_DIR}"; \
    curl -fsSL -o /tmp/jbr-jcef.tar.gz "${JCEF_JBR_URL}"; \
    tar -xzf /tmp/jbr-jcef.tar.gz -C "${JCEF_JBR_DIR}" --strip-components=1; \
    rm -f /tmp/jbr-jcef.tar.gz; \
    test -f "${JCEF_JBR_DIR}/lib/libjcef.so"

# --- Android SDK (one or more API levels, no emulator) ----------------------
# ANDROID_API_LEVELS / ANDROID_BUILD_TOOLS are space-separated lists — override
# at build time, e.g. --build-arg ANDROID_API_LEVELS="33 34 35 36". The default
# installs API 34 + 36 so both are available out of the box.
ARG ANDROID_SDK_ROOT=/opt/android-sdk
ARG ANDROID_CMDLINE_TOOLS_VERSION=14742923
ARG ANDROID_API_LEVELS="34 36"
ARG ANDROID_BUILD_TOOLS="34.0.0 36.0.0"
ENV ANDROID_SDK_ROOT=/opt/android-sdk \
    ANDROID_HOME=/opt/android-sdk \
    JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 \
    ANDROID_API_LEVELS="${ANDROID_API_LEVELS}"

RUN set -eux; \
    zip=/tmp/cmdline-tools.zip; \
    curl -fsSL -o "${zip}" \
        "https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_CMDLINE_TOOLS_VERSION}_latest.zip"; \
    mkdir -p "${ANDROID_SDK_ROOT}/cmdline-tools"; \
    unzip -q "${zip}" -d /tmp/cmdline-tools-extract; \
    # sdkmanager expects to live under cmdline-tools/latest/
    mv /tmp/cmdline-tools-extract/cmdline-tools "${ANDROID_SDK_ROOT}/cmdline-tools/latest"; \
    rm -rf "${zip}" /tmp/cmdline-tools-extract; \
    sdk="${ANDROID_SDK_ROOT}/cmdline-tools/latest/bin/sdkmanager"; \
    yes | "${sdk}" --sdk_root="${ANDROID_SDK_ROOT}" --licenses >/dev/null; \
    pkgs="platform-tools"; \
    for lvl in ${ANDROID_API_LEVELS}; do \
        pkgs="${pkgs} platforms;android-${lvl} sources;android-${lvl}"; \
    done; \
    for bt in ${ANDROID_BUILD_TOOLS}; do \
        pkgs="${pkgs} build-tools;${bt}"; \
    done; \
    "${sdk}" --sdk_root="${ANDROID_SDK_ROOT}" ${pkgs}; \
    chmod -R a+rX "${ANDROID_SDK_ROOT}" /opt/che-android-studio; \
    for lvl in ${ANDROID_API_LEVELS}; do \
        test -d "${ANDROID_SDK_ROOT}/platforms/android-${lvl}"; \
    done; \
    test ! -d "${ANDROID_SDK_ROOT}/emulator"

# TODO(custom-android-sdk): inject a custom-built Android platform here (replace/
# augment platforms/android-<L> + register it in the IDE's jdk.table.xml). A
# runtime drop-in hook (CUSTOM_ANDROID_SDK_DIR) also exists in the entrypoint.
# The stock android-<L> platforms above are the baseline.

# Put the SDK tools on PATH for headless app-build use of this image, and for the
# streamed IDE (which inherits this env) to find adb/sdkmanager.
ENV PATH="${ANDROID_SDK_ROOT}/cmdline-tools/latest/bin:${ANDROID_SDK_ROOT}/platform-tools:${PATH}"

WORKDIR /home/user
