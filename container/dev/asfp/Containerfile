# asfp-dev — the ASfP (platform) flavor's dev/runtime container.
#
# This is the container the ASfP GUI is CONTRIBUTED into (via the editor
# definition's controller.devfile.io/container-contribution) and where the
# user's terminal lives. Layer order: SDK base → desktop.
#
#   1. FROM che-android-studio-sdk — lean Ubuntu + Android SDK + JCEF JBR (built
#      once in the standalone SDK image; not re-run here).
#   2. Desktop layer (setup-desktop.sh) — openbox + KasmVNC + GUI libs + passwd
#      fix, identical to the studio flavor.
#
# NOTE: asfp-dev and studio-dev share this SDK base and differ only by the IDE
# flavor env below. A heavier variant carrying a full Android platform (AOSP)
# build toolchain can be layered on top of this base as a future addition.
#
# Build (context = container/):
#   podman build -t asfp-dev:latest -f container/dev/asfp/Containerfile container/

ARG SDK_TAG=latest
ARG IMAGE_PREFIX=ghcr.io/belt-build/che-android-studio
FROM ${IMAGE_PREFIX}/sdk:${SDK_TAG}
ARG DEBIAN_FRONTEND=noninteractive

# SDK + JCEF JBR + ANDROID_SDK_ROOT/PATH already come from the base image.
ENV JCEF_JBR_DIR=/opt/che-android-studio/jbr-jcef

# ASfP config-dir version (AndroidStudioForPlatform<major.minor.micro>) — the
# entrypoint seeds first-run options into this dir. Keep in sync with the ASfP
# version baked in the injector image.
ARG ASFP_MAJOR_MINOR=2025.3.2
ENV ASFP_MAJOR_MINOR=${ASFP_MAJOR_MINOR} \
    IDE_FLAVOR=asfp

# --- Desktop layer (shared with studio-dev) ----------------------------------
# NOTE: copy openbox/rc.xml AFTER setup-desktop installs openbox — if our file
# is present first, openbox's .deb postinst prompts about the modified conffile
# and (with no stdin) the build fails.
COPY kasmvnc-subpath-fix.html /usr/share/che-android-studio/kasmvnc-subpath-fix.html
COPY inject-subpath-fix.py    /usr/local/bin/che-android-studio-inject-subpath
COPY desktop/setup-desktop.sh /usr/local/bin/che-android-studio-setup-desktop
RUN chmod 0755 /usr/local/bin/che-android-studio-setup-desktop \
                /usr/local/bin/che-android-studio-inject-subpath \
    && /usr/local/bin/che-android-studio-setup-desktop
COPY openbox/rc.xml /etc/xdg/openbox/rc.xml
COPY openbox/dark-themerc /usr/share/themes/StudioDark/openbox-3/themerc

# --- Entrypoint --------------------------------------------------------------
# Runs the desktop session (KasmVNC → openbox → injected IDE). The editor
# definition's start command execs this in the contribution-merged container.
COPY entrypoint.sh /usr/local/bin/che-android-studio-entrypoint
RUN chmod 0755 /usr/local/bin/che-android-studio-entrypoint

WORKDIR /home/user
EXPOSE 6901
CMD ["/usr/local/bin/che-android-studio-entrypoint"]
